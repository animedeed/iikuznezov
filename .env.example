# Set these environment variables before launching the process.
IIKUZNEZOV_DB=data/iikuznezov.sqlite3

# Set the key and folder together to enable the Yandex model adapter.
YANDEX_LLM_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=yandexgpt-5.1

# Test Telegram and mail accounts.
TELEGRAM_BOT_TOKEN=
YANDEX_MAIL_ADDRESS=
YANDEX_MAIL_APP_PASSWORD=
IIKUZNEZOV_TEST_RECIPIENT=
MAIL_RECIPIENTS=

# CalDAV for the integrated pilot.
PILOT_CALDAV_URL=
PILOT_CALDAV_USER=
PILOT_CALDAV_PASSWORD=

# Optional. Required for the Linux Telemost voice client.
YANDEX_SPEECH_API_KEY=

# Private token for an integrated meeting session. Set it only in the client process.
IIKUZNEZOV_MEETING_TOKEN=
