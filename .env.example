# Set these environment variables before launching the process.
IIKUZNEZOV_DB=data/iikuznezov.sqlite3

# Optional. Set the key and folder together to enable the Yandex model adapter.
YANDEX_LLM_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=yandexgpt-5.1

# Dedicated m001 integration scenario (process environment)
TELEGRAM_BOT_TOKEN=
YANDEX_MAIL_ADDRESS=
YANDEX_MAIL_APP_PASSWORD=
IIKUZNEZOV_TEST_RECIPIENT=
